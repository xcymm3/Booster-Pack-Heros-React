{
  "name": "booster-pack-heroes-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:h5": "taro build --type h5 --watch",
    "build:h5": "taro build --type h5",
    "build:exe": "npm run build:h5 && node desktop/package-windows.cjs",
    "build:exe:compact": "npm run build:h5 && node desktop/package-windows.cjs --compact",
    "typecheck": "tsc --noEmit",
    "verify:h5": "node scripts/verify-campaign.cjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": {
    "@tarojs/components": "4.3.3",
    "@tarojs/helper": "4.3.3",
    "@tarojs/plugin-framework-react": "4.3.3",
    "@tarojs/plugin-platform-h5": "4.3.3",
    "@tarojs/react": "4.3.3",
    "@tarojs/runtime": "4.3.3",
    "@tarojs/shared": "4.3.3",
    "@tarojs/taro": "4.3.3",
    "@tarojs/taro-h5": "4.3.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/plugin-transform-class-properties": "^7.29.7",
    "@tarojs/cli": "4.3.3",
    "@tarojs/vite-runner": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "postcss": "^8.5.0",
    "typescript": "~5.9.3",
    "vite": "^4.5.14"
  }
